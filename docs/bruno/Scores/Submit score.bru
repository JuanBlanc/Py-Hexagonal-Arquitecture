meta {
  name: Submit score
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/matches/{{matchId}}/scores
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "player_id": "{{playerId}}",
    "points": 1500
  }
}

docs {
  La partida debe estar iniciada (Start match) antes de enviar puntuaciones.
}
