# Python path — necesario para desarrollo local
# Ejecutar con: PYTHONPATH=app uvicorn main:app --reload
PYTHONPATH=app

# Persistencia: "memory" (por defecto) o "postgres"
PERSISTENCE=memory

# Solo si PERSISTENCE=postgres. Usa el driver asyncpg.
DATABASE_URL=postgresql+asyncpg://game:game@db:5432/game_engine
