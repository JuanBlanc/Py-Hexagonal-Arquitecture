meta {
  name: Create match
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/matches
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "game_id": "{{gameId}}",
    "host_player_id": "{{playerId}}"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("matchId", res.body.match_id);
  }
}
