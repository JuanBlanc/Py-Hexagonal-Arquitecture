meta {
  name: Add game
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/games
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Speed Chess",
    "genre": "strategy",
    "max_players": 2
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("gameId", res.body.game_id);
  }
}
